+<script setup lang="ts">
+import { ref, computed, onMounted, watch } from 'vue'
+import MemberSignIn from 'src/components/MemberSignIn.vue'
+import { useMemberStore } from 'src/stores/member'
+import { useRewardsStore, type MentorSession } from 'src/stores/rewards'
+import { useSettlements } from 'src/lib/settlements'
+import { MAX_SELF_REPORT_HOURS } from 'src/data/rewards-catalog'
+import { supabase } from 'src/lib/supabase'
+
+const member  = useMemberStore()
+const rewards = useRewardsStore()
+const { settlements, getSettlement, updateSettlement } = useSettlements()
+
+const TRACKS = [
+  { key: 'finance_literacy', label: 'finance literacy', color: '#44ff88' },
+  { key: 'volunteering',     label: 'volunteering',     color: '#ffaa33' },
+  { key: 'educating_others', label: 'educating others', color: '#cc88ff' },
+] as const
+
+const submitting = ref(false)
+
+// Self-report
+const vDesc  = ref('')
+const vHours = ref<number | null>(null)
+const vMsg   = ref('')
+
+// Mentorship
+const menteeId = ref('')
+const mTopic   = ref('')
+const mMsg     = ref('')
+
+// Attach
+const attachObjectKey     = ref('')
+const attachSettlementKey = ref('')
+const attachMsg           = ref('')
+
+// Display names for connections / session parties.
+const names = ref<Record<string, string>>({})
+
+onMounted(load)
+watch(() => member.userId, load)
+
+async function load () {
+  if (!member.isSignedIn) return
+  await rewards.loadMyRewards()
+  await loadNames()
+}
+
+async function loadNames () {
+  if (!supabase) return
+  const ids = new Set<string>(member.connectedIds)
+  for (const s of rewards.sessions) { ids.add(s.mentor_id); ids.add(s.mentee_id) }
+  if (member.userId) ids.delete(member.userId)
+  if (!ids.size) return
+  const { data } = await supabase.from('members').select('id,display_name').in('id', [...ids])
+  if (data) for (const m of data as { id: string; display_name: string }[]) names.value[m.id] = m.display_name
+}
+
+const volunteerEvents = computed(() => rewards.events.filter(e => e.track === 'volunteering'))
+
+function hasCert (type: string) { return rewards.unlockedCertificateTypes.has(type) }
+function nameFor (id: string) { return names.value[id] ?? id.slice(0, 8) }
+function otherPartyName (s: MentorSession) {
+  return nameFor(s.mentor_id === member.userId ? s.mentee_id : s.mentor_id)
+}
+function myConfirmation (s: MentorSession) {
+  return s.mentor_id === member.userId ? s.confirmed_mentor : s.confirmed_mentee
+}
+function shortDate (iso: string) { return new Date(iso).toLocaleDateString() }
+
+async function submitSelfReport () {
+  if (!vDesc.value || !vHours.value) return
+  submitting.value = true
+  const res = await rewards.selfReportVolunteerHours(vDesc.value, vHours.value)
+  submitting.value = false
+  vMsg.value = res.ok ? `Logged — +${res.points} points (self-reported).` : 'Could not log — check you are signed in.'
+  if (res.ok) { vDesc.value = ''; vHours.value = null }
+}
+
+async function submitRequest () {
+  if (!menteeId.value || !mTopic.value) return
+  submitting.value = true
+  const res = await rewards.requestMentorSession(menteeId.value, mTopic.value)
+  submitting.value = false
+  mMsg.value = res.ok ? 'Session requested — confirm it once, then ask your mentee to confirm too.' : 'Could not request — a green-light connection is required.'
+  if (res.ok) { menteeId.value = ''; mTopic.value = ''; await loadNames() }
+}
+
+async function confirm (sessionId: string) {
+  submitting.value = true
+  await rewards.confirmMentorSession(sessionId)
+  submitting.value = false
+}
+
+function attach () {
+  const key = attachSettlementKey.value
+  const existing = getSettlement(key)?.objects ?? []
+  if (!existing.includes(attachObjectKey.value)) {
+    updateSettlement(key, { objects: [...existing, attachObjectKey.value] })
+  }
+  attachMsg.value = 'Attached to settlement (saved locally).'
+  attachObjectKey.value = ''
+  attachSettlementKey.value = ''
+}
+</script>
