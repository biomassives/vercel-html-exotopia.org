+/**
+ * src/data/rewards-catalog.ts
+ * Static catalog for the settlement-rewards foundation: point values,
+ * unlockable settlement objects, and the quiz→reward mapping.
+ *
+ * Point values mirror SPEC_ECOOPS_COMMUNITY_PLATFORM.md §3.1 where the
+ * categories overlap. Object colors reuse the palette already used in
+ * OnboardPage.vue's settlementItems for visual continuity with onboarding.
+ */
+
+export type RewardTrack = 'volunteering' | 'finance_literacy' | 'educating_others'
+
+// ── Point values, keyed by action_key ───────────────────────────────────────
+// action_key is free text in the DB (no enum) so new actions need no migration;
+// this map is just the client-side source of truth for how many points to award.
+export const POINTS: Record<string, number> = {
+  pfin8_complete:        25,
+  pfin28_complete:       60,
+  eco_submission:        10,
+  volunteer_self_report:  5,  // per hour, capped in the store (see MAX_SELF_REPORT_HOURS)
+  mentor_session:        40,  // emitted server-side by the DB trigger; here for reference
+}
+
+// Self-reported volunteer hours are capped so the MVP fallback can't be farmed.
+export const MAX_SELF_REPORT_HOURS = 4
+
+// ── Unlockable settlement objects ────────────────────────────────────────────
+// Surfaced as an account-level inventory on RewardsPage; attaching one to a
+// specific settlement is a metadata write via settlements.ts updateSettlement.
+export interface SettlementObject {
+  key:   string
+  label: string
+  color: string
+  unlockedBy: { track: RewardTrack; actionKey: string }
+}
+
+export const SETTLEMENT_OBJECTS: SettlementObject[] = [
+  {
+    key: 'pfin_seed', label: 'Financial Literacy Settlement Seed', color: '#44ff88',
+    unlockedBy: { track: 'finance_literacy', actionKey: 'pfin8_complete' },
+  },
+  {
+    key: 'pfin_parallel_world', label: 'Parallel-Universe Settlement', color: '#00e5ff',
+    unlockedBy: { track: 'finance_literacy', actionKey: 'pfin28_complete' },
+  },
+  {
+    key: 'field_station', label: 'Eco Field Station', color: '#ffaa33',
+    unlockedBy: { track: 'volunteering', actionKey: 'eco_submission' },
+  },
+  {
+    key: 'mentor_beacon', label: 'Mentor Beacon', color: '#cc88ff',
+    unlockedBy: { track: 'educating_others', actionKey: 'mentor_session' },
+  },
+]
+
+// ── Quiz → reward mapping ────────────────────────────────────────────────────
+// Only quizzes listed here carry rewards. minScore is the number of correct
+// answers required; prerequisite is a certificate_type that must already be
+// held before this reward can be earned (gates pfin28 behind pfin8).
+export interface QuizRewardRule {
+  track:               RewardTrack
+  actionKey:           string
+  certificateType:     string
+  settlementObjectKey: string
+  minScore:            number
+  prerequisite:        string | null
+}
+
+export const QUIZ_REWARD_MAP: Record<string, QuizRewardRule> = {
+  pfin8: {
+    track: 'finance_literacy', actionKey: 'pfin8_complete',
+    certificateType: 'pfin8', settlementObjectKey: 'pfin_seed',
+    minScore: 6, prerequisite: null,
+  },
+  pfin28: {
+    track: 'finance_literacy', actionKey: 'pfin28_complete',
+    certificateType: 'pfin28', settlementObjectKey: 'pfin_parallel_world',
+    minScore: 20, prerequisite: 'pfin8',
+  },
+}
+
+/** Object keys unlocked by a set of held certificate types. */
+export function objectsForCertificates(certTypes: Set<string>): SettlementObject[] {
+  // A certificate_type maps to a settlement object either directly (its own
+  // key, for quizzes) or via the object's unlockedBy.actionKey (mentorship).
+  const unlockedActionKeys = new Set<string>()
+  for (const rule of Object.values(QUIZ_REWARD_MAP)) {
+    if (certTypes.has(rule.certificateType)) unlockedActionKeys.add(rule.actionKey)
+  }
+  if (certTypes.has('mentorship')) unlockedActionKeys.add('mentor_session')
+  return SETTLEMENT_OBJECTS.filter(o => unlockedActionKeys.has(o.unlockedBy.actionKey))
+}
