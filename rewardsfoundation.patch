+/**
+ * src/data/finance-literacy-quiz.ts
+ * Original finance-literacy quiz content, aligned to the P-Fin framework's
+ * eight functional areas (earning, consuming, saving, investing, borrowing
+ * & managing debt, insuring, comprehending risk, go-to information sources).
+ *
+ * This is ORIGINAL content we wrote — it is aligned to the P-Fin framework,
+ * not a reproduction of the TIAA Institute–GFLEC proprietary instrument.
+ *
+ * Shape reuses QuizArea / QuizQuestion from ./quizzes so LearnPage.vue's
+ * existing quiz-card UI, progress tracking, and scoring need no new UI.
+ * pfin8  gates the settlement-seed reward; pfin28 (prereq: pfin8) gates the
+ * parallel-universe upgrade. Reward mapping lives in ./rewards-catalog.
+ */
+import type { QuizArea } from './quizzes'
+
+// ── P-Fin 8 — one question per literacy area ────────────────────────────────
+
+export const pfin8: QuizArea = {
+  id: 'pfin8', title: 'P-Fin 8 · Financial Literacy', emoji: '🪙',
+  description: 'Eight questions, one per personal-finance literacy area. Score 6+ to unlock your settlement seed. Aligned to the P-Fin framework — original content, not a financial product.',
+  difficulty: 'beginner', color: 'rgba(68,204,136,0.80)',
+  badge: 'P-Fin Literate', questionCount: 8,
+  questions: [
+    {
+      // Earning
+      question: 'EARNING — Your gross pay is the amount before deductions. Which of these most directly reduces gross pay to arrive at your net (take-home) pay?',
+      options: [
+        'The interest earned on your savings account',
+        'Income tax and payroll deductions withheld by your employer',
+        'The current rate of inflation',
+        'The balance on your credit card',
+      ],
+      correct: 1,
+      explanation: 'Net (take-home) pay is gross pay minus deductions — income tax withholding, payroll taxes, and any pre-tax contributions like retirement or health premiums. Understanding the gap between gross and net is the foundation of budgeting from what you actually earn.',
+    },
+    {
+      // Consuming
+      question: 'CONSUMING — A budget is a plan for matching spending to income. If your income is fixed and one spending category rises, keeping the budget balanced requires that you…',
+      options: [
+        'Borrow the difference every month indefinitely',
+        'Reduce another category, increase income, or both',
+        'Ignore it, because budgets balance automatically',
+        'Only track the categories that went up',
+      ],
+      correct: 1,
+      explanation: 'A budget is a constraint: with fixed income, a rise in one category must be offset by a cut elsewhere or by earning more. Relying on borrowing to close a recurring monthly gap turns a spending problem into a debt problem.',
+    },
+    {
+      // Saving
+      question: 'SAVING — An emergency fund is money set aside for unexpected expenses. Where should an emergency fund normally be held?',
+      options: [
+        'In a volatile stock so it grows as fast as possible',
+        'In a liquid, low-risk account you can access quickly without loss',
+        'Locked in a multi-year product with a withdrawal penalty',
+        'As cash lent to friends at interest',
+      ],
+      correct: 1,
+      explanation: 'An emergency fund\'s job is availability, not growth. It belongs somewhere liquid and low-risk — a savings or money-market account — so it holds its value and can be reached immediately when the emergency actually happens.',
+    },
+    {
+      // Investing
+      question: 'INVESTING — Diversification means spreading money across many different investments. Its main purpose is to…',
+      options: [
+        'Guarantee a fixed return every year',
+        'Reduce the impact of any single investment performing badly',
+        'Eliminate all risk entirely',
+        'Avoid ever paying any tax',
+      ],
+      correct: 1,
+      explanation: 'Diversification lowers exposure to the failure of any one holding — when investments do not all move together, a loss in one is cushioned by others. It reduces risk but cannot guarantee returns or remove risk completely.',
+    },
+    {
+      // Borrowing & managing debt
+      question: 'BORROWING & DEBT — Two loans offer the same amount. Loan A charges 12% APR, Loan B charges 24% APR. Repaying the same balance over the same period, Loan B will…',
+      options: [
+        'Cost less in total interest',
+        'Cost the same, because APR does not affect cost',
+        'Cost more in total interest',
+        'Be interest-free after the first payment',
+      ],
+      correct: 2,
+      explanation: 'APR (annual percentage rate) is the yearly cost of borrowing. A higher APR means more interest paid over the life of the loan for the same balance and term. Comparing APRs is the quickest way to see which debt is more expensive.',
+    },
+    {
+      // Insuring
+      question: 'INSURING — A deductible is the amount you pay out of pocket before insurance covers the rest. All else equal, choosing a higher deductible usually…',
+      options: [
+        'Raises your regular premium',
+        'Lowers your regular premium but increases what you pay when you claim',
+        'Means the insurer pays for everything immediately',
+        'Has no effect on cost either way',
+      ],
+      correct: 1,
+      explanation: 'A higher deductible shifts more of the first-dollar risk onto you, so the insurer charges a lower premium. The trade-off: you pay more out of pocket at claim time. The right choice depends on your ability to absorb that up-front cost.',
+    },
+    {
+      // Comprehending risk
+      question: 'COMPREHENDING RISK — In personal finance, the relationship between risk and expected return is generally that…',
+      options: [
+        'Higher potential return tends to come with higher risk',
+        'Lower risk always produces higher returns',
+        'Risk and return are unrelated',
+        'The safest option always pays the most',
+      ],
+      correct: 0,
+      explanation: 'The risk–return trade-off is central: investments offering higher expected returns generally carry greater uncertainty and greater chance of loss. Anything promising high returns with no risk should be treated as a warning sign.',
+    },
+    {
+      // Go-to information sources
+      question: 'INFORMATION SOURCES — You get financial advice from someone who earns a commission on the specific product they recommend. This is an example of…',
+      options: [
+        'A neutral, disinterested source',
+        'A potential conflict of interest to weigh before acting',
+        'A reason the advice must be correct',
+        'Information that requires no further checking',
+      ],
+      correct: 1,
+      explanation: 'When an information source is paid based on what you buy, their incentive may not fully align with your interest — a conflict of interest. Good practice is to identify how a source is compensated and cross-check advice against independent information.',
+    },
+  ],
+}
+
+// ── P-Fin 28 — deeper coverage, ~3–4 per area ───────────────────────────────
+
+export const pfin28: QuizArea = {
+  id: 'pfin28', title: 'P-Fin 28 · Full Index', emoji: '🌐',
+  description: 'Twenty-eight questions across all eight literacy areas. Complete P-Fin 8 first. Score 20+ to upgrade your settlement into a parallel-universe world. Original content aligned to the P-Fin framework.',
+  difficulty: 'intermediate', color: 'rgba(0,229,255,0.80)',
+  badge: 'P-Fin Master', questionCount: 28,
+  questions: [
+    // ── Earning (4) ──────────────────────────────────────────────────────
+    {
+      question: 'EARNING — "Pre-tax" retirement contributions reduce your taxable income now. The main effect is that…',
+      options: [
+        'You pay more tax this year',
+        'Less of your income is taxed this year; tax is generally deferred until withdrawal',
+        'The contribution is never taxed at any point',
+        'Your gross pay increases',
+      ],
+      correct: 1,
+      explanation: 'Pre-tax contributions come out before income tax is calculated, lowering this year\'s taxable income. Tax is typically deferred until you withdraw the money later, often in retirement.',
+    },
+    {
+      question: 'EARNING — Which typically increases lifetime earning potential the most?',
+      options: [
+        'Never changing jobs',
+        'Building marketable skills and relevant education or credentials',
+        'Keeping all savings in cash',
+        'Avoiding all workplace benefits',
+      ],
+      correct: 1,
+      explanation: 'Human capital — skills, education, and experience — is the largest driver of earning potential over a working life. Investing in marketable, relevant capability generally raises income more than any single financial tactic.',
+    },
+    {
+      question: 'EARNING — An employer matches retirement contributions up to 4% of pay. Contributing at least 4% is often described as…',
+      options: [
+        'A poor idea because it locks up money',
+        'Effectively leaving free money on the table if you do not',
+        'The same as contributing nothing',
+        'Only worthwhile for high earners',
+      ],
+      correct: 1,
+      explanation: 'An employer match is additional compensation contingent on your contribution. Contributing at least enough to capture the full match is usually one of the highest-return moves available, because the match is an immediate 100% return on that portion.',
+    },
+    {
+      question: 'EARNING — A "1099" or self-employed worker differs from a "W-2" employee mainly because they…',
+      options: [
+        'Never pay any tax',
+        'Are generally responsible for setting aside their own taxes, including self-employment tax',
+        'Cannot deduct any business expenses',
+        'Always earn less',
+      ],
+      correct: 1,
+      explanation: 'Independent/self-employed workers usually have no tax withheld for them, so they must set aside and remit their own income and self-employment taxes — often via quarterly estimated payments. Failing to plan for this is a common cash-flow trap.',
+    },
+
+    // ── Consuming (3) ────────────────────────────────────────────────────
+    {
+      question: 'CONSUMING — The difference between a "need" and a "want" matters most when…',
+      options: [
+        'Income is unlimited',
+        'Money is tight and you must prioritise spending',
+        'You never use a budget',
+        'Prices never change',
+      ],
+      correct: 1,
+      explanation: 'Distinguishing needs (housing, food, essential transport) from wants lets you protect essentials first when resources are constrained. It is the core discipline behind any workable budget.',
+    },
+    {
+      question: 'CONSUMING — Lifestyle inflation refers to…',
+      options: [
+        'Prices rising across the whole economy',
+        'Spending rising to match income as you earn more, leaving little extra saved',
+        'A discount on luxury goods',
+        'A type of insurance',
+      ],
+      correct: 1,
+      explanation: 'Lifestyle inflation (or lifestyle creep) is when spending expands to absorb every raise, so higher income does not translate into higher saving. Recognising it lets you direct raises toward goals instead.',
+    },
+    {
+      question: 'CONSUMING — Comparing the unit price (price per ounce, litre, or item) between two package sizes helps you…',
+      options: [
+        'Avoid ever spending money',
+        'Judge which option is genuinely cheaper regardless of package size',
+        'Increase the total you spend',
+        'Calculate your income tax',
+      ],
+      correct: 1,
+      explanation: 'Unit pricing normalises cost across different package sizes, exposing which product is truly cheaper. A bigger package is not automatically better value — the unit price tells you.',
+    },
+
+    // ── Saving (4) ───────────────────────────────────────────────────────
+    {
+      question: 'SAVING — Compound interest means you earn returns on…',
+      options: [
+        'Only your original deposit',
+        'Both your original deposit and previously earned interest',
+        'Only money you withdraw',
+        'Nothing until the account closes',
+      ],
+      correct: 1,
+      explanation: 'Compounding means interest is added to the balance and then itself earns interest. Over long periods this snowball effect is powerful, which is why starting to save early matters so much.',
+    },
+    {
+      question: 'SAVING — A common guideline for an emergency fund is to hold roughly…',
+      options: [
+        'One day of expenses',
+        'Three to six months of essential expenses',
+        'Ten years of income',
+        'Exactly one month of income, never more',
+      ],
+      correct: 1,
+      explanation: 'A widely used rule of thumb is three to six months of essential living expenses, adjusted for job stability and dependents. The goal is to cover income disruption or large surprises without resorting to high-cost debt.',
+    },
+    {
+      question: 'SAVING — "Paying yourself first" means…',
+      options: [
+        'Spending on wants before anything else',
+        'Automatically directing a set amount to savings before discretionary spending',
+        'Repaying friends before bills',
+        'Only saving whatever is left at month end',
+      ],
+      correct: 1,
+      explanation: 'Paying yourself first automates saving up front, so it is not left to willpower or to whatever happens to remain. Treating savings like a fixed bill is one of the most reliable ways to build wealth steadily.',
+    },
+    {
+      question: 'SAVING — If a savings account pays 2% while inflation is 5%, the real (inflation-adjusted) value of that money is…',
+      options: [
+        'Growing quickly',
+        'Falling, because prices rise faster than the interest earned',
+        'Perfectly preserved',
+        'Unaffected by inflation',
+      ],
+      correct: 1,
+      explanation: 'Real return is roughly the nominal rate minus inflation. Earning 2% while inflation runs 5% means purchasing power shrinks about 3% a year — the money grows in dollars but buys less over time.',
+    },
+
+    // ── Investing (4) ────────────────────────────────────────────────────
+    {
+      question: 'INVESTING — Over long horizons, stocks have historically offered higher average returns than cash or bonds, but with…',
+      options: [
+        'No downside ever',
+        'Greater short-term volatility and risk of loss',
+        'A government guarantee',
+        'Lower returns than a checking account',
+      ],
+      correct: 1,
+      explanation: 'The historical pattern is higher long-run average returns for stocks accompanied by larger short-term swings. Time horizon matters: volatility that is painful over months has historically mattered less over decades.',
+    },
+    {
+      question: 'INVESTING — A low-cost index fund is popular largely because it…',
+      options: [
+        'Guarantees you beat the market',
+        'Offers broad diversification at low fees, tracking a market segment',
+        'Holds a single company',
+        'Avoids all market risk',
+      ],
+      correct: 1,
+      explanation: 'An index fund holds a broad basket mirroring an index, delivering instant diversification at low cost. It will not beat the market, but low fees and broad exposure make it a common core holding.',
+    },
+    {
+      question: 'INVESTING — Fees matter because, compounded over decades, a 1% higher annual fee…',
+      options: [
+        'Has no measurable effect',
+        'Can consume a large share of your total returns',
+        'Increases your returns',
+        'Is refunded at retirement',
+      ],
+      correct: 1,
+      explanation: 'Fees compound against you just as returns compound for you. Over a multi-decade horizon, seemingly small annual fee differences can erode a substantial portion of the final balance.',
+    },
+    {
+      question: 'INVESTING — "Time in the market beats timing the market" points to the finding that…',
+      options: [
+        'You should trade as often as possible',
+        'Staying invested consistently tends to beat trying to predict short-term moves',
+        'Markets are easy to time precisely',
+        'Investing is pointless',
+      ],
+      correct: 1,
+      explanation: 'Consistently missing even a handful of the best days can sharply cut long-run returns, and those days are hard to predict. Staying invested through cycles has historically outperformed attempts to jump in and out.',
+    },
+
+    // ── Borrowing & managing debt (4) ────────────────────────────────────
+    {
+      question: 'BORROWING & DEBT — Making only the minimum payment on a credit card generally means…',
+      options: [
+        'The balance is cleared fastest',
+        'You pay far more in interest and take much longer to clear the balance',
+        'No interest is ever charged',
+        'The card is closed automatically',
+      ],
+      correct: 1,
+      explanation: 'Minimum payments mostly cover interest, so the principal falls slowly and interest keeps accruing. A modest balance can take years and cost multiples of the original amount if only minimums are paid.',
+    },
+    {
+      question: 'BORROWING & DEBT — A credit score primarily helps lenders assess…',
+      options: [
+        'Your annual income exactly',
+        'How likely you are to repay borrowed money on time',
+        'Your net worth',
+        'How much tax you owe',
+      ],
+      correct: 1,
+      explanation: 'A credit score summarises repayment history and credit use into a measure of credit risk. A stronger score generally means access to credit on better terms (lower rates), which can save significant money over time.',
+    },
+    {
+      question: 'BORROWING & DEBT — Which action most reliably helps a credit score over time?',
+      options: [
+        'Missing payments occasionally',
+        'Paying bills on time and keeping credit-card balances low relative to limits',
+        'Maxing out every card',
+        'Closing your oldest account',
+      ],
+      correct: 1,
+      explanation: 'Payment history and credit utilisation are major scoring factors. Paying on time and keeping balances low relative to limits are the most dependable ways to build and protect a score.',
+    },
+    {
+      question: 'BORROWING & DEBT — A "secured" loan differs from an "unsecured" loan because the secured loan…',
+      options: [
+        'Has no interest',
+        'Is backed by collateral the lender can claim if you default',
+        'Can never be repaid early',
+        'Is only for businesses',
+      ],
+      correct: 1,
+      explanation: 'A secured loan (like a mortgage or auto loan) is backed by an asset the lender can seize on default, which usually lowers the rate. An unsecured loan (like most credit cards) has no collateral and typically carries a higher rate.',
+    },
+
+    // ── Insuring (3) ─────────────────────────────────────────────────────
+    {
+      question: 'INSURING — The core purpose of insurance is to…',
+      options: [
+        'Guarantee a profit',
+        'Transfer the financial risk of a large, unlikely loss to an insurer for a premium',
