diff --git a/src/stores/rewards.ts b/src/stores/rewards.ts
new file mode 100644
index 0000000..5494e44
--- /dev/null
+++ b/src/stores/rewards.ts
@@ -0,0 +1,213 @@
+import { defineStore } from 'pinia'
+import { ref, computed } from 'vue'
+import { supabase } from 'src/lib/supabase'
+import { useMemberStore } from 'src/stores/member'
+import {
+  POINTS, MAX_SELF_REPORT_HOURS, QUIZ_REWARD_MAP,
+  objectsForCertificates, type RewardTrack, type SettlementObject,
+} from 'src/data/rewards-catalog'
+
+// ── Row types (public.reward_events / certificates / mentor_sessions) ────────
+
+export interface RewardEvent {
+  id:         string
+  member_id:  string
+  track:      RewardTrack
+  action_key: string
+  points:     number
+  metadata:   Record<string, unknown> | null
+  created_at: string
+}
+
+export interface Certificate {
+  id:                    string
+  member_id:             string
+  certificate_type:      string
+  settlement_object_key: string | null
+  source_event_id:       string | null
+  issued_at:             string
+}
+
+export interface MentorSession {
+  id:               string
+  mentor_id:        string
+  mentee_id:        string
+  topic:            string | null
+  confirmed_mentor: boolean
+  confirmed_mentee: boolean
+  created_at:       string
+  confirmed_at:     string | null
+}
+
+const EMPTY_BY_TRACK: Record<RewardTrack, number> = {
+  volunteering: 0, finance_literacy: 0, educating_others: 0,
+}
+
+export const useRewardsStore = defineStore('rewards', () => {
+  const events   = ref<RewardEvent[]>([])
+  const certs    = ref<Certificate[]>([])
+  const sessions = ref<MentorSession[]>([])
+  const loading  = ref(false)
+  const error    = ref<string | null>(null)
+
+  const member = useMemberStore()
+
+  // ── Computed ─────────────────────────────────────────────────────────────
+  const totalPoints = computed(() => events.value.reduce((s, e) => s + e.points, 0))
+
+  const pointsByTrack = computed<Record<RewardTrack, number>>(() => {
+    const out = { ...EMPTY_BY_TRACK }
+    for (const e of events.value) out[e.track] += e.points
+    return out
+  })
+
+  const unlockedCertificateTypes = computed<Set<string>>(
+    () => new Set(certs.value.map(c => c.certificate_type)),
+  )
+
+  const unlockedObjects = computed<SettlementObject[]>(
+    () => objectsForCertificates(unlockedCertificateTypes.value),
+  )
+  const unlockedObjectKeys = computed<string[]>(() => unlockedObjects.value.map(o => o.key))
+
+  // Sessions this member is part of that are not yet fully confirmed.
+  const pendingSessions = computed(() =>
+    sessions.value.filter(s => !s.confirmed_at),
+  )
+
+  // ── Load ─────────────────────────────────────────────────────────────────
+  async function loadMyRewards () {
+    const uid = member.userId
+    if (!supabase || !uid) { events.value = []; certs.value = []; sessions.value = []; return }
+    loading.value = true
+    error.value   = null
+    try {
+      const [ev, ce, se] = await Promise.all([
+        supabase.from('reward_events').select('*').eq('member_id', uid).order('created_at', { ascending: false }),
+        supabase.from('certificates').select('*').eq('member_id', uid),
+        supabase.from('mentor_sessions').select('*').or(`mentor_id.eq.${uid},mentee_id.eq.${uid}`),
+      ])
+      if (ev.data) events.value   = ev.data as RewardEvent[]
+      if (ce.data) certs.value    = ce.data as Certificate[]
+      if (se.data) sessions.value = se.data as MentorSession[]
+    } catch (e) {
+      error.value = String(e)
+    } finally {
+      loading.value = false
+    }
+  }
+
+  // ── Finance-literacy: quiz completion ────────────────────────────────────
+  // Returns a small result the caller (LearnPage) can surface in its UI.
+  async function awardQuizCompletion (areaId: string, score: number, _total: number) {
+    const uid = member.userId
+    if (!supabase || !uid) return { awarded: false, reason: 'signed-out' as const }
+
+    const rule = QUIZ_REWARD_MAP[areaId]
+    if (!rule) return { awarded: false, reason: 'no-reward' as const }
+    if (score < rule.minScore) return { awarded: false, reason: 'below-min' as const, minScore: rule.minScore }
+    if (rule.prerequisite && !unlockedCertificateTypes.value.has(rule.prerequisite)) {
+      return { awarded: false, reason: 'prerequisite' as const, prerequisite: rule.prerequisite }
+    }
+    // Already certified — idempotent no-op (no duplicate points).
+    if (unlockedCertificateTypes.value.has(rule.certificateType)) {
+      return { awarded: false, reason: 'already-earned' as const }
+    }
+
+    const points = POINTS[rule.actionKey] ?? 0
+    const { data: evRow, error: evErr } = await supabase
+      .from('reward_events')
+      .insert({ member_id: uid, track: rule.track, action_key: rule.actionKey, points, metadata: { areaId, score } })
+      .select()
+      .single()
+    if (evErr) { error.value = evErr.message; return { awarded: false, reason: 'error' as const } }
+
+    await supabase
+      .from('certificates')
+      .upsert({
+        member_id:             uid,
+        certificate_type:      rule.certificateType,
+        settlement_object_key: rule.settlementObjectKey,
+        source_event_id:       (evRow as RewardEvent | null)?.id ?? null,
+      }, { onConflict: 'member_id,certificate_type', ignoreDuplicates: true })
+
+    await loadMyRewards()
+    return { awarded: true as const, points, certificateType: rule.certificateType, objectKey: rule.settlementObjectKey }
+  }
+
+  // ── Volunteering ─────────────────────────────────────────────────────────
+  // Auto-logged from eco-offline.ts on real sync success.
+  async function logVolunteerAction (actionKey: string, metadata: Record<string, unknown>) {
+    const uid = member.userId
+    if (!supabase || !uid) return
+    const points = POINTS[actionKey] ?? 0
+    await supabase.from('reward_events').insert({
+      member_id: uid, track: 'volunteering', action_key: actionKey, points, metadata,
+    })
+  }
+
+  // MVP fallback while the eco_ops schema tables don't exist. Capped points,
+  // clearly labeled self-reported so the UI can distinguish it.
+  async function selfReportVolunteerHours (description: string, hours: number) {
+    const uid = member.userId
+    if (!supabase || !uid) return { ok: false }
+    const cappedHours = Math.max(0, Math.min(hours, MAX_SELF_REPORT_HOURS))
+    const points = Math.round(cappedHours * POINTS.volunteer_self_report)
+    const { error: e } = await supabase.from('reward_events').insert({
+      member_id: uid, track: 'volunteering', action_key: 'volunteer_self_report', points,
+      metadata: { description, hours, cappedHours, selfReported: true },
+    })
+    if (e) { error.value = e.message; return { ok: false } }
+    await loadMyRewards()
+    return { ok: true, points }
+  }
+
+  // ── Educating others: mentorship ─────────────────────────────────────────
+  // Thin wrappers — reward emission happens in the DB trigger, not here.
+  async function requestMentorSession (menteeId: string, topic: string) {
+    const uid = member.userId
+    if (!supabase || !uid) return { ok: false }
+    const { error: e } = await supabase.from('mentor_sessions').insert({
+      mentor_id: uid, mentee_id: menteeId, topic,
+    })
+    if (e) { error.value = e.message; return { ok: false } }
+    await loadMyRewards()
+    return { ok: true }
+  }
+
+  // Flip the current user's confirmation flag on a session. The BEFORE UPDATE
+  // trigger enforces that only the caller's own flag can change; sending both
+  // flags true is harmless (the trigger reverts the flag you don't own).
+  async function confirmMentorSession (sessionId: string) {
+    const uid = member.userId
+    if (!supabase || !uid) return { ok: false }
+    const s = sessions.value.find(x => x.id === sessionId)
+    if (!s) return { ok: false }
+    const patch = s.mentor_id === uid ? { confirmed_mentor: true } : { confirmed_mentee: true }
+    const { error: e } = await supabase.from('mentor_sessions').update(patch).eq('id', sessionId)
+    if (e) { error.value = e.message; return { ok: false } }
+    await loadMyRewards()
+    return { ok: true }
+  }
+
+  // ── Admin-granted credit (bounty / docs contribution) ────────────────────
+  // Gated by is_admin() at the RLS layer, not client-side.
+  async function adminGrantReward (
+    memberId: string, track: RewardTrack, actionKey: string, points: number,
+    metadata: Record<string, unknown> = {},
+  ) {
+    if (!supabase) return { ok: false }
+    const { error: e } = await supabase.from('reward_events').insert({
+      member_id: memberId, track, action_key: actionKey, points, metadata,
+    })
+    if (e) { error.value = e.message; return { ok: false } }
+    return { ok: true }
+  }
+
+  return {
+    events, certs, sessions, loading, error,
+    totalPoints, pointsByTrack, unlockedCertificateTypes, unlockedObjects, unlockedObjectKeys, pendingSessions,
+    loadMyRewards, awardQuizCompletion, logVolunteerAction, selfReportVolunteerHours,
+    requestMentorSession, confirmMentorSession, adminGrantReward,
+  }
+})
diff --git a/supabase/migrations/002_rewards.sql b/supabase/migrations/002_rewards.sql
new file mode 100644
index 0000000..9c5cf71
--- /dev/null
+++ b/supabase/migrations/002_rewards.sql
@@ -0,0 +1,198 @@
+-- ============================================================
+-- Settlement Rewards & Incentive Foundation
+-- Migration 002 — points ledger, certificates, mentorship
+-- ============================================================
+--
+-- One shared foundation behind the three reward-earning paths:
+--   finance_literacy  — P-Fin quizzes (client-award MVP)
+--   volunteering      — eco-ops sync + self-report (client-award MVP)
+--   educating_others  — peer mentorship (server-enforced via trigger)
+--
+-- Reuses the primitives from 001_blog_comments.sql:
+--   public.members            — FK anchor (auth.users.id)
+--   public.connections        — green-light mutual opt-in
+--   public.is_connected(uuid) — trust check used for mentor pairing
+--
+-- Everything is client-trust MVP (RLS restricts WHO writes a row for
+-- themselves, not the point value claimed) EXCEPT mentor-session
+-- confirmation, where a single client could otherwise fabricate a
+-- reward for two people — that path is server-enforced by trigger.
+-- ============================================================
+
+-- ── Append-only points ledger ───────────────────────────────
+CREATE TABLE public.reward_events (
+  id         uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
+  member_id  uuid        NOT NULL REFERENCES public.members(id) ON DELETE CASCADE,
+  track      text        NOT NULL CHECK (track IN ('volunteering','finance_literacy','educating_others')),
+  action_key text        NOT NULL,   -- free text, not enum — new action types need no migration
+  points     int         NOT NULL CHECK (points >= 0),
+  metadata   jsonb,                  -- quiz score, submission id, bounty url, mentor session id...
+  created_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX ON public.reward_events (member_id, created_at);
+CREATE INDEX ON public.reward_events (track);
+
+-- ── Issued credentials (one per member per type) ─────────────
+CREATE TABLE public.certificates (
+  id                    uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
+  member_id             uuid        NOT NULL REFERENCES public.members(id) ON DELETE CASCADE,
+  certificate_type      text        NOT NULL,
+  settlement_object_key text,
+  source_event_id       uuid        REFERENCES public.reward_events(id) ON DELETE SET NULL,
+  issued_at             timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (member_id, certificate_type)
+);
+
+-- ── Peer-to-peer "educating others" credit ───────────────────
+CREATE TABLE public.mentor_sessions (
+  id               uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
+  mentor_id        uuid        NOT NULL REFERENCES public.members(id) ON DELETE CASCADE,
+  mentee_id        uuid        NOT NULL REFERENCES public.members(id) ON DELETE CASCADE,
+  topic            text,
+  confirmed_mentor bool        NOT NULL DEFAULT false,
+  confirmed_mentee bool        NOT NULL DEFAULT false,
+  created_at       timestamptz NOT NULL DEFAULT now(),
+  confirmed_at     timestamptz,
+  CHECK (mentor_id <> mentee_id)
+);
+
+CREATE INDEX ON public.mentor_sessions (mentor_id);
+CREATE INDEX ON public.mentor_sessions (mentee_id);
+
+-- ── Minimal admin allow-list ─────────────────────────────────
+-- Manual INSERT after a real member signs up (see seed note at foot),
+-- exactly like the 7-member test-group pattern in 001_blog_comments.sql.
+-- This is NOT a roles system — just an allow-list for admin-granted credit.
+CREATE TABLE public.admin_members (
+  member_id uuid PRIMARY KEY REFERENCES public.members(id) ON DELETE CASCADE
+);
+
+CREATE OR REPLACE FUNCTION public.is_admin()
+RETURNS boolean LANGUAGE sql SECURITY DEFINER AS $$
+  SELECT EXISTS (SELECT 1 FROM public.admin_members WHERE member_id = auth.uid())
+$$;
+
+-- ── Convenience view for a future leaderboard ────────────────
+CREATE VIEW public.member_points AS
+  SELECT member_id, COALESCE(SUM(points), 0) AS total_points
+  FROM public.reward_events
+  GROUP BY member_id;
+
+-- ============================================================
+-- Row Level Security
+-- ============================================================
+
+ALTER TABLE public.reward_events   ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.certificates    ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.mentor_sessions ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.admin_members   ENABLE ROW LEVEL SECURITY;
+
+-- reward_events / certificates: public Impact Profile (same posture as
+-- members_read_all). Insert only for self or admin. No UPDATE/DELETE
+-- policy at all — the ledger is append-only, enforced by omission.
+CREATE POLICY "reward_events_read_all" ON public.reward_events FOR SELECT USING (true);
+CREATE POLICY "reward_events_insert"   ON public.reward_events FOR INSERT
+  WITH CHECK (member_id = auth.uid() OR public.is_admin());
+
+CREATE POLICY "certificates_read_all"  ON public.certificates FOR SELECT USING (true);
+CREATE POLICY "certificates_insert"    ON public.certificates FOR INSERT
+  WITH CHECK (member_id = auth.uid() OR public.is_admin());
+
+-- mentor_sessions: visible to and updatable by the two parties (or admin).
+-- Insert only by the mentor, and only against an already green-lit mentee.
+CREATE POLICY "mentor_sessions_read" ON public.mentor_sessions FOR SELECT
+  USING (mentor_id = auth.uid() OR mentee_id = auth.uid() OR public.is_admin());
+CREATE POLICY "mentor_sessions_insert" ON public.mentor_sessions FOR INSERT
+  WITH CHECK (mentor_id = auth.uid() AND public.is_connected(mentee_id));
+CREATE POLICY "mentor_sessions_update" ON public.mentor_sessions FOR UPDATE
+  USING (mentor_id = auth.uid() OR mentee_id = auth.uid());
+
+-- admin_members: readable (so is_admin-style checks can run client-side if
+-- ever needed) but never client-writable — seeded manually via SQL.
+CREATE POLICY "admin_members_read" ON public.admin_members FOR SELECT USING (true);
+
+-- ============================================================
+-- Mentor-session anti-gaming triggers
+-- ============================================================
+
+-- BEFORE UPDATE: a party can only ever flip THEIR OWN confirmation flag,
+-- regardless of what the client sends. Identity/topic columns are immutable
+-- through UPDATE. confirmed_at is stamped the instant both flags are true.
+CREATE OR REPLACE FUNCTION public.mentor_session_guard()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  -- Immutable columns — always preserved from the existing row.
+  NEW.mentor_id  := OLD.mentor_id;
+  NEW.mentee_id  := OLD.mentee_id;
+  NEW.topic      := OLD.topic;
+  NEW.created_at := OLD.created_at;
+
+  -- Each party may flip only their own flag. A non-party update (should be
+  -- blocked by RLS already) can flip neither.
+  IF auth.uid() IS DISTINCT FROM OLD.mentor_id THEN
+    NEW.confirmed_mentor := OLD.confirmed_mentor;
+  END IF;
+  IF auth.uid() IS DISTINCT FROM OLD.mentee_id THEN
+    NEW.confirmed_mentee := OLD.confirmed_mentee;
+  END IF;
+
+  -- confirmed_at is derived, never client-set. Stamp once, never clear.
+  IF NEW.confirmed_mentor AND NEW.confirmed_mentee AND OLD.confirmed_at IS NULL THEN
+    NEW.confirmed_at := now();
+  ELSE
+    NEW.confirmed_at := OLD.confirmed_at;
+  END IF;
+
+  RETURN NEW;
+END;
+$$;
+
+CREATE TRIGGER mentor_session_guard_trg
+  BEFORE UPDATE ON public.mentor_sessions
+  FOR EACH ROW EXECUTE FUNCTION public.mentor_session_guard();
+
+-- AFTER UPDATE: the moment a session becomes fully confirmed, emit one
+-- reward for EACH party server-side (a single client cannot fabricate both
+-- sides). SECURITY DEFINER — same escalation pattern as is_connected() — so
+-- the inserts run as the table owner and bypass the self-only RLS check.
+-- At the mentor's 4th confirmed session, issue a mentorship certificate.
+CREATE OR REPLACE FUNCTION public.emit_mentor_rewards()
+RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $$
+DECLARE
+  confirmed_count int;
+BEGIN
+  INSERT INTO public.reward_events (member_id, track, action_key, points, metadata)
+  VALUES
+    (NEW.mentor_id, 'educating_others', 'mentor_session', 40,
+       jsonb_build_object('session_id', NEW.id, 'role', 'mentor', 'topic', NEW.topic)),
+    (NEW.mentee_id, 'educating_others', 'mentor_session', 40,
+       jsonb_build_object('session_id', NEW.id, 'role', 'mentee', 'topic', NEW.topic));
+
+  SELECT count(*) INTO confirmed_count
+  FROM public.mentor_sessions
+  WHERE mentor_id = NEW.mentor_id AND confirmed_at IS NOT NULL;
+
+  IF confirmed_count >= 4 THEN
+    INSERT INTO public.certificates (member_id, certificate_type, settlement_object_key)
+    VALUES (NEW.mentor_id, 'mentorship', 'mentor_beacon')
+    ON CONFLICT (member_id, certificate_type) DO NOTHING;
+  END IF;
+
+  RETURN NEW;
+END;
+$$;
+
+CREATE TRIGGER emit_mentor_rewards_trg
+  AFTER UPDATE ON public.mentor_sessions
+  FOR EACH ROW
+  WHEN (NEW.confirmed_at IS NOT NULL AND OLD.confirmed_at IS NULL)
+  EXECUTE FUNCTION public.emit_mentor_rewards();
+
