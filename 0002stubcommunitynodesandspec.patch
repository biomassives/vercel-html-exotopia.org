+/**
+ * src/stores/community-nodes.ts
+ *
+ * STUB — placeholder for the community-nodes feature (business listings,
+ * creative pages, and future node types) described in DOCS.md.
+ *
+ * This exists so the routes and the two callers of fetchGalleryNodes() resolve
+ * and the app builds. The real implementation is not written yet:
+ *
+ *   - there is no `community_nodes` migration in supabase/migrations/, so the
+ *     table referenced by src/stores/member.ts:180 does not exist server-side
+ *   - SPEC_COMMUNITY_NODES.md, referenced from DOCS.md, has not been added
+ *
+ * fetchGalleryNodes() therefore returns an empty list rather than querying a
+ * table that isn't there — which is exactly the behaviour the orbital-gallery
+ * pipeline had before this feature was started. Callers already treat an empty
+ * array as "no galleries in this system", so nothing renders differently.
+ *
+ * When implementing for real: add the migration, then replace the body of
+ * fetchGalleryNodes() with a query filtered by hostname, mapping each row to an
+ * OrbitalGalleryEntry (see src/lib/defender-nav.types.ts).
+ */
+
+import { defineStore } from 'pinia'
+import { ref } from 'vue'
+import type { OrbitalGalleryEntry } from 'src/lib/defender-nav.types'
+
+export const useCommunityNodesStore = defineStore('community-nodes', () => {
+  const loading = ref(false)
+
+  /**
+   * Orbital gallery nodes for a star system.
+   *
+   * @param hostname  Host star name, or null when the system is unresolved.
+   * @returns         Always [] until the backing table and spec exist.
+   */
+  async function fetchGalleryNodes(hostname: string | null): Promise<OrbitalGalleryEntry[]> {
+    void hostname
+    return []
+  }
+
+  return { loading, fetchGalleryNodes }
+})
