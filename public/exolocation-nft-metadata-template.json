  "name": "Exotopia Property: Aurora Basin",
  "symbol": "EXOPROP",
  "description": "Virtual bounded property on Kepler-452b assigned to the Eco Warriors group under the PON INK protocol. Aurora Basin is a settlement zone on the planet's temperate northern continent.",
  "image": "ipfs://REPLACE_WITH_CID/image.png",
  "animation_url": null,
