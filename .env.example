# ── Supabase ─────────────────────────────────────────────────────────────────
# Create a free project at supabase.com, then copy these from:
#   Project Settings → API → Project URL and anon/public key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key-here

# ── Algorand (existing) ───────────────────────────────────────────────────────
# VITE_ALGO_NODE=https://mainnet-api.algonode.cloud
# VITE_ALGO_INDEXER=https://mainnet-idx.algonode.cloud

# ── IPFS pinning (Pinata v3) ─────────────────────────────────────────────────
# Create a SCOPED key at pinata.cloud → API Keys → New Key. Under
# Permissions → Files, enable "Write" only — that's all the v3 upload call
# in src/lib/ipfs-pinning.ts needs (POST uploads.pinata.cloud/v3/files).
# Leave Groups/Gateways/Analytics off, and do NOT use an Admin key: this is
# a VITE_ var, so it ships in the public client bundle and is readable by
# anyone who opens devtools on the deployed site.
# VITE_PINATA_JWT=your-scoped-pinata-jwt-here
